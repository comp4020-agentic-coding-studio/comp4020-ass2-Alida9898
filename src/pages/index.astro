---
import "../styles/site.css";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import CreatureCut from "../components/CreatureCut.astro";
import Specimen from "../components/Specimen.astro";
import { courseMeta } from "../course-config";
import { bestiary } from "../lib/bestiary";
import { ALL_SECTIONS, CHAPTERS, EDITION } from "../lib/shanhaijing";
import { PHASE_LABELS, weeks, type Phase } from "../lib/weeks";
import { siteConfig } from "../site-config";

// 首页不放大图。模板那张讲堂插画跟这门课没关系，而 hero 一旦存在，第一屏就先是一张
// 图而不是这门课要教的能力。ContentLayout 在没有 heroImage 时会自己渲染 h1 和 lead。
//
// 版面规则，一次定死，全页照办：
//   圆角 2px（跟 Specimen 和 Hierarchy 一致），强调色只有 --at-primary 一个，
//   文字颜色只用 --at-text / --at-text-secondary，任何地方不许 opacity。
//   暗色模式靠 token 和 currentColor，不写第二套配色。
//
// One radius (2px), one accent (--at-primary), no `opacity` on text anywhere:
// in this repo opacity multiplies against tokens that already carry alpha and
// has failed axe in Chrome. Dark mode is handled by the theme's tokens and by
// `currentColor`, so there is no second palette to keep in sync.

// 每一个数字都从数据里数出来，没有一个是写死的。
// Every number on this page is counted from committed data. Nothing is typed in.
const PHASE_NOTES: Record<Phase, { verb: string; note: string }> = {
  build: {
    verb: "Build a system that works",
    note: "Characters, ranks, two-part names. You apply them to the cleanest records in the book and they fit, which is the part that should worry you.",
  },
  stress: {
    verb: "Push it until it strains",
    note: "Omens, medicinal uses, the line between a god and a beast. Each one is a candidate character that turns out to fail a different test.",
  },
  rebuild: {
    verb: "Take it apart and rebuild",
    note: "One name over many creatures, one creature under many names. Then other traditions, and then a system of your own for material nobody has sorted.",
  },
};

const phases = (Object.keys(PHASE_LABELS) as Phase[]).map((phase) => {
  const span = weeks.filter((week) => week.phase === phase).map((week) => week.week);
  return {
    phase,
    label: PHASE_LABELS[phase],
    from: Math.min(...span),
    to: Math.max(...span),
    ...PHASE_NOTES[phase],
  };
});

// 有线图的六只。首页只用画过的，没画过的不出现。
const DRAWN = ["帝江", "陆吾", "毕方", "夫诸", "九尾狐", "并封"];

// 手写的 <a href="/..."> 不会被 Astro 补 base，部署后就是 404。主题的 Card 组件
// 自己处理，这里不用组件，所以自己补。
//
// A root-absolute href written by hand in an `.astro` file skips Astro's base
// handling: it resolves on localhost and 404s under `/comp4020-ass2-Alida9898/`.
// The theme's Card does this internally; these links are plain anchors, so they
// do it here. The build's link checker fails on a miss, which is how the first
// version of this page was caught.
const withBase = (path: string): string =>
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}${path}`;

const facts = [
  { value: String(weeks.length), label: "weeks" },
  { value: String(bestiary.length), label: "creature records" },
  { value: String(CHAPTERS.length), label: "chapters, all of them read" },
  { value: String(ALL_SECTIONS.length), label: "mountain routes" },
  { value: "1", label: "edition, cited line by line" },
];
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  {...siteConfig}
>
  <section class="outcome">
    <h2>What you leave able to do</h2>
    <ol class="outcome__steps">
      <li>
        <h3>Choose characters</h3>
        <p>
          Decide which features of a thing can be compared across every case, and
          say why the ones you rejected do not qualify.
        </p>
      </li>
      <li>
        <h3>Build the hierarchy</h3>
        <p>
          Nest those characters so that a claim made high up holds for everything
          underneath it, and nothing has to be restated.
        </p>
      </li>
      <li>
        <h3>Name the limits</h3>
        <p>
          State where your own system fails before anyone else finds it. Every
          system has an edge. Declaring it is the difference between a taxonomy
          and a guess.
        </p>
      </li>
    </ol>
    <p class="outcome__transfer">
      The final assessment hands you material you have not seen and asks for all
      three.
    </p>
  </section>

  <section class="phases">
    <h2>Three phases, four weeks each</h2>
    <ol class="phases__list">
      {
        phases.map((phase) => (
          <li class="phase">
            <p class="phase__span">
              Weeks {phase.from} to {phase.to}
            </p>
            <h3 class="phase__verb">{phase.verb}</h3>
            <p class="phase__note">{phase.note}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="set">
    <h2>The training set</h2>
    <p class="set__intro">
      The <span lang="zh-Hans">山海经</span> (Shānhǎijīng, the <i>Classic of
      Mountains and Seas</i>) files hundreds of creatures by where you would meet
      them and never says what any of them is a kind of. It is a good training
      set precisely because it resists: a book that sorted itself cleanly would
      teach you nothing about choosing characters.
    </p>

    <ul class="cuts" aria-label="Six creatures from the bestiary, drawn as line art">
      {
        DRAWN.map((name) => (
          <li>
            <CreatureCut name={name} size={104} />
            <p lang="zh-Hans">{name}</p>
          </li>
        ))
      }
    </ul>

    <dl class="facts">
      {
        facts.map((fact) => (
          <div>
            <dt>{fact.value}</dt>
            <dd>{fact.label}</dd>
          </div>
        ))
      }
    </dl>

    <p class="set__rule">
      Every quoted line comes from one edition, <span lang="zh-Hant"
        >{EDITION.title}</span
      >, <span lang="zh-Hant">{EDITION.edition}</span>, and no page writes a line
      of its own. Where a line cannot be found, the entry says so and claims
      nothing after that. The binomials are this course's inventions and every
      page that prints one says so.
    </p>
  </section>

  <section class="record">
    <h2>One record, in full</h2>
    <p>
      This is a single entry, printed the way every week prints its own. Read the
      fields and you have read the raw material of the whole course.
    </p>
    <Specimen name="狌狌" />
  </section>

  <section class="next">
    <h2>Where to go next</h2>
    <ul class="next__list">
      <li>
        <a href={withBase("/sessions/")}>The twelve weeks</a>
        <p>Each week's rule, the creatures it is tested against, and how the two hours run.</p>
      </li>
      <li>
        <a href={withBase("/assessments/")}>Assessment</a>
        <p>Five pieces of work. What each is worth, and what the final one asks for.</p>
      </li>
      <li>
        <a href={withBase("/lectures/")}>Lectures</a>
        <p>The hour that opens each week, and the one deck the course ships.</p>
      </li>
      <li>
        <a href={withBase("/decks/week-03/")}>Week 3 slides</a>
        <p>Morphology. The one week whose argument is visual, so the one week with a deck.</p>
      </li>
    </ul>
  </section>
</ContentLayout>

<style>
  /* 一套圆角，一个强调色。全页共用。
     首屏交给 ContentLayout：它渲染 h1 和 lead（course-config 的 description），
     所以这里不再自己造一个 hero，否则第一屏会出现两个标题。 */
  .outcome,
  .phases,
  .set,
  .record,
  .next {
    margin-block: 3.5rem;
  }

  /* 1. 能力。编号推进，不是三张等宽卡。 */
  .outcome__steps {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .outcome__steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0 1rem;
    padding-block: 1.1rem;
    border-block-start: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .outcome__steps li::before {
    content: counter(step);
    grid-row: 1 / span 2;
    font-variant-numeric: tabular-nums;
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--at-primary);
  }

  /* 主题的标题色是琥珀 --at-primary，在页面底色上实测 3.44:1（Chrome，
     2026-09-19）。够 3:1 的大字门槛，不够 4.5:1 的正文门槛，而这些标题是
     19.8px，属于正文档。所以标题的字号和颜色不能各选各的：这里改回正文色。
     The step number below stays amber because it is 25.2px, over the 24px
     large-text threshold, where 3.44:1 is a pass. */
  .outcome__steps h3 {
    margin: 0;
    font-size: 1.1rem;
    color: var(--at-text);
  }

  .outcome__steps p {
    margin: 0.2rem 0 0;
    max-width: 58ch;
    color: var(--at-text-secondary);
  }

  .outcome__transfer {
    margin: 1.25rem 0 0;
    padding-inline-start: 0.85rem;
    border-inline-start: 3px solid var(--at-primary);
    max-width: 58ch;
  }

  /* 3. 三阶段。横排的带子，跟上面的编号列表不同族。 */
  .phases__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .phase {
    padding: 1.25rem 1.25rem 1.4rem;
  }

  .phase + .phase {
    border-inline-start: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  /* 14px 的琥珀小标签实测 3.44:1，不过 4.5:1。改用 --at-text-secondary（8.92:1），
     同时去掉全大写和字距：它是一行数据标签，不是又一个小标题。 */
  .phase__span {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--at-text-secondary);
  }

  .phase__verb {
    margin: 0.35rem 0 0;
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--at-text);
  }

  .phase__note {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--at-text-secondary);
  }

  /* 4. 训练集。线图带 + 数字行，本页唯一的图像区。 */
  .set__intro,
  .set__rule {
    max-width: 62ch;
  }

  .set__rule {
    font-size: 0.95rem;
    color: var(--at-text-secondary);
  }

  .cuts {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
    margin: 2rem 0;
    padding: 0;
    list-style: none;
  }

  .cuts li {
    text-align: center;
  }

  .cuts p {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--at-text-secondary);
    letter-spacing: normal;
    font-feature-settings: normal;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(5, auto);
    justify-content: start;
    gap: 0 2.5rem;
    margin: 0 0 1.5rem;
    padding-block: 1rem;
    border-block: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .facts dt {
    font-size: 1.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .facts dd {
    margin: 0.3rem 0 0;
    max-width: 14ch;
    font-size: 0.85rem;
    color: var(--at-text-secondary);
  }

  /* 5. 一条记录。Specimen 自带版式，这里只给标题留白。 */
  .record p {
    max-width: 62ch;
  }

  /* 6. 去处。链接列表，不是等宽卡片网格。 */
  .next__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .next__list li {
    padding: 1rem 1.25rem 1.2rem 0;
    border-block-start: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }

  .next__list a {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .next__list p {
    margin: 0.25rem 0 0;
    max-width: 42ch;
    font-size: 0.92rem;
    color: var(--at-text-secondary);
  }

  /* 中文不跟拉丁字母一样加字距。 */
  [lang^="zh"] {
    letter-spacing: normal;
    font-feature-settings: normal;
  }

  /* 手机：每一个多列版面都在这里显式塌成单列。 */
  @media (max-width: 52rem) {
    .phases__list,
    .next__list {
      grid-template-columns: 1fr;
    }

    .phase {
      padding-inline: 0;
    }

    .phase + .phase {
      border-inline-start: 0;
      border-block-start: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    }

    .cuts {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem 0.5rem;
    }

    .facts {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 1.5rem;
    }

    .next__list li {
      padding-inline-end: 0;
    }
  }
</style>
