---
import "../../styles/site.css";
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import Toc from "../../components/Toc.astro";
import { formatCourseDate } from "../../lib/dates";
import { PHASE_LABELS, weeks } from "../../lib/weeks";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content, headings } = await render(session);

// 阶段从大纲查，不由页面自己写，这样十二周不可能各说各话。
// The phase is looked up from the syllabus rather than restated in frontmatter,
// so no week page can claim a phase the syllabus disagrees with. The rule and
// the creature list ARE in frontmatter, because a week has to be able to say
// its own rule on its own page; `spec/course.test.ts` checks the two agree.
const syllabus = weeks.find((week) => week.week === session.data.week);
const phase = syllabus?.phase;
const phaseNumber = phase === "build" ? 1 : phase === "stress" ? 2 : 3;
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p>
    <strong>{formatCourseDate(session.data.date)}</strong>
    {phase && <> · Phase {phaseNumber}, {PHASE_LABELS[phase]}</>}
  </p>

  <section class="rule" aria-labelledby="rule-heading">
    <h2 id="rule-heading">The rule this week states</h2>
    <p class="rule__text">{session.data.rule}</p>
  </section>

  <Toc headings={headings} />

  <Content />

  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
</ContentLayout>

<style>
  /* 周页要在左边留出目录导轨的位置，所以正文列比站里其他页窄一档。
     根字号是 18px，所以 42rem = 756px，行宽约 84 字符——比常规的 45–75 长，
     这是为了页眉换来的：页眉一行要 291+27+360+27+45 = 750px，低于这个值
     搜索按钮会单独掉到第二行，周页的页眉就和站内其它页不一样了。
     主题的那条竖线画在 (100% - --at-content-inset - --at-content-width) / 2，
     所以这个值一改，竖线和导轨都跟着动——Toc.astro 从同一组变量算自己的位置。
     Week pages carry a contents rail in the left margin, so their column is one
     step narrower than the rest of the site. 42rem is the first step that still
     fits the header on one row: it needs 750px, and below that the search button
     drops to a second row on its own. The theme's vertical rule is drawn from
     this value, and so is the rail, so the three move together. */
  :global(html) {
    --at-content-width: 42rem;

    /* 主题只把正文列居中，导轨挂在它左边，所以看到的那一整组是偏左的：
       1372px 窗口下左边只剩 18px，右边空了 290px。
       整组 = 带子（导轨 + 间距）+ 竖线 + 内距 + 正文。要让这一组居中，
       就把带子的一半补给正文，两边余量自然相等。
       导轨宽和间距先按「整组居中」算出来，不是按「正文居中」算——
       这是为什么居中之后导轨反而变宽了，它不再被挤在剩下的半边里。
       The theme centres the column alone, so the group the reader actually
       sees — rail, gap, rule, column — sits left of centre with the whole
       remainder piled up on the right. Reserving a band for the rail and
       giving the column back half of it centres the group instead. Rail and
       gap are sized from that same centred geometry, which is why the rail
       gets wider here rather than narrower. */
    --week-col: calc(var(--at-content-width) + var(--at-content-inset));
    /* 读者看到的「导轨到正文」不是这个间距，是间距 + 竖线到正文的内距（2rem）。
       所以 4rem 的间距读起来是 108px 的空，太散；收到 2.5rem 之后是 81px。
       导轨盒子的右缘本来就贴着竖线，所以能收的只有这一段——
       再往右挪导轨就得连竖线和正文一起右移，那又跟「正文左移」打架。
       What the reader sees between rail and text is this gap plus the rule's
       2rem inset, so 4rem read as 108px of air. 2.5rem makes it 81px. The
       rail's box already sits flush against the rule, so this is the only
       slack there is: moving the rail further right would mean moving the
       rule and the column right with it, against the last change. */
    --week-gap: clamp(2rem, calc(100vw - var(--week-col) - 15rem - 4rem), 2.5rem);
    --week-rail: min(15rem, calc(100vw - var(--week-col) - var(--week-gap) - 4rem));
    --week-band: calc(var(--week-rail) + var(--week-gap));
  }

  /* 断点和 Toc.astro 里的那个必须一样，改一个就要改另一个。
     Keep this breakpoint in step with the one in Toc.astro. */
  @media (min-width: 72rem) {
    /* 居中要改的是 body 的轨道，不是任何一个盒子。
       main 是 subgrid，它的子元素挂在 body 的轨道线上，所以给 main 加外边距
       只会移动它那个空盒子，标题和正文一动不动——这条路试过，是死的。
       改轨道则 main、页眉内层、页脚内层一起跟上，因为它们都是 subgrid；
       而通栏元素跨的是 full-start/full-end，仍然是 0 到 100vw，
       页脚那道横线和页眉的底色都不受影响。
       Centring is a change to body's tracks, not to any box. main is a subgrid,
       so its children sit on body's lines and margins on main move an empty
       box while the text stays — that was tried and it does nothing. Retracking
       moves main, the header inner and the footer inner together, because all
       three are subgrids, while full-bleed elements still span full-start to
       full-end and keep the footer's rule and the header's background at the
       window edges.

       几何居中偏右：正文是一整块黑，导轨是稀疏的几行字，等分两边余量之后
       眼睛仍然把重心读在右边。所以左边只给四分之一，右边留四分之三，
       整组往左让半个边距——这是视觉居中，不是几何居中。
       间距和导轨宽都不变，动的只是两边余量怎么分。
       Splitting the leftover evenly still reads right-heavy: the column is a
       solid block and the rail is a few sparse lines. The left margin takes a
       quarter of the leftover and the right three quarters, moving the group
       half a margin left. This is optical centring, not geometric. The gap and
       the rail keep their widths; only the split changes. */
    :global(body) {
      grid-template-columns:
        [full-start]
        calc(var(--week-band) + (100% - var(--week-band) - var(--week-col)) / 4)
        [inset-start]
        var(--at-content-inset)
        [content-start]
        var(--at-content-width)
        [content-end]
        1fr
        [full-end];
    }

    /* 竖线是 body::after，主题按「正文居中」算它的位置，所以要重算到 inset-start。
       The rule is body::after, positioned by the theme for a centred column, so
       it is recomputed onto the new inset-start line. */
    :global(body::after) {
      inset-inline-start: calc(
        var(--week-band) + (100% - var(--week-band) - var(--week-col)) / 4
      );
    }
  }

  /* 第三周那张五列的零件表，在 390 上会撑出横向滚动。主题的 .at-table-wrap 是个
     滚动容器但不带 tabindex（它的注释说现代浏览器会自己让滚动容器可聚焦），
     axe 4.12 在 Chrome 里仍然判 scrollable-region-focusable 为 serious。
     与其争这个，不如让表在 390 上就装得下：缩这一张，别的表不动——
     第 1、2 周的表本来就不溢出，跟着缩只会更难读。
     The five-column parts table on week 3 overflows at 390. The theme's
     wrapper is a scroll container with no tabindex, which axe 4.12 reports as
     a serious violation in Chrome, so this makes the table fit instead of
     arguing with the tool. Scoped to this one table: the tables on weeks 1 and
     2 already fit, and shrinking them would only make them harder to read. */
  @media (max-width: 40rem) {
    :global(.parts-table table) {
      font-size: 0.78rem;
    }

    :global(.parts-table :is(th, td)) {
      padding-inline: 0.4rem;
    }
  }

  /* 规则块是每周页面的骨架，所以它不能靠颜色区分，得靠位置和边框。 */
  .rule {
    margin: 1.5rem 0 2rem;
    padding: 0.75rem 0 0.75rem 1rem;
    border-left: 4px solid var(--at-primary);
  }

  .rule h2 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .rule__text {
    margin: 0.35rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--at-text);
  }
</style>
