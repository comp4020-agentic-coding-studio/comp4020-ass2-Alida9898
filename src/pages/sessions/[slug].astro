---
import "../../styles/site.css";
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import SpecList from "astro-course-university/components/SpecList.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import Toc from "../../components/Toc.astro";
import { formatCourseDate } from "../../lib/dates";
import { PHASE_LABELS, weeks } from "../../lib/weeks";
import { graphCollections, sessionLabels, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const sessions = await getPublishedCollection("sessions");
  return sessions.map((session) => ({ params: { slug: session.id }, props: { session } }));
}

const { session } = Astro.props;
const { Content, headings } = await render(session);

// 阶段从大纲查，不由页面自己写，这样十二周不可能各说各话。
// The phase is looked up from the syllabus rather than restated in frontmatter,
// so no week page can claim a phase the syllabus disagrees with. The rule and
// the creature list ARE in frontmatter, because a week has to be able to say
// its own rule on its own page; `spec/course.test.ts` checks the two agree.
const syllabus = weeks.find((week) => week.week === session.data.week);
const phase = syllabus?.phase;
const phaseNumber = phase === "build" ? 1 : phase === "stress" ? 2 : 3;
---

<ContentLayout
  title={`Week ${session.data.week} ${sessionLabels.singular}: ${session.data.title}`}
  description={session.data.description}
  {...siteConfig}
>
  <p>
    <strong>{formatCourseDate(session.data.date)}</strong>
    {phase && <> · Phase {phaseNumber}, {PHASE_LABELS[phase]}</>}
  </p>

  <section class="rule" aria-labelledby="rule-heading">
    <h2 id="rule-heading">The rule this week states</h2>
    <p class="rule__text">{session.data.rule}</p>
  </section>

  <Toc headings={headings} />

  <Content />

  <SpecList spec={session.data.spec}>
    What you bring to the session. Written so a reader can tell whether it has
    been met without asking you.
  </SpecList>
  <TeachingTeam teachers={session.data.teachers} />
  <RelatedContent entry={session} collections={graphCollections} />
</ContentLayout>

<style>
  /* 周页要在左边留出目录导轨的位置，所以正文列比站里其他页窄一档。
     48rem 的列放不下导轨；34rem 之后左边距足够，行宽约 52ch，接近书籍正文的宽度。
     Week pages carry a contents rail in the left margin, so their column is one
     step narrower than the rest of the site. At 48rem there is no room for the
     rail at the width this site is actually read at. */
  :global(html) {
    --at-content-width: 34rem;
  }

  /* 规则块是每周页面的骨架，所以它不能靠颜色区分，得靠位置和边框。 */
  .rule {
    margin: 1.5rem 0 2rem;
    padding: 0.75rem 0 0.75rem 1rem;
    border-left: 4px solid var(--at-primary);
  }

  .rule h2 {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
  }

  .rule__text {
    margin: 0.35rem 0 0;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--at-text);
  }
</style>
